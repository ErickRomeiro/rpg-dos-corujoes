# PostgreSQL — use Neon (https://neon.tech) para dev/prod
DATABASE_URL="postgresql://user:password@host/database"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Google OAuth — crie em https://console.cloud.google.com
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# E-mails que viram OWNER automaticamente (separados por vírgula)
OWNER_EMAILS=

# Vercel Blob — guarda os retratos das fichas.
# O store precisa ser Public: o retrato é carregado por <img src> inclusive no
# link público da ficha (/f/[token]), onde quem abre não está logado.
# Sem isso, o app funciona; só o envio de retrato fica indisponível.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID="seu-email@gmail.com"
